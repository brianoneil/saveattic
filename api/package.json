{
  "name": "saveattic-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute saveattic-db --file=../schema.sql",
    "db:init:remote": "wrangler d1 execute saveattic-db --file=../schema.sql --remote",
    "db:create": "wrangler d1 create saveattic-db",
    "media:create": "wrangler r2 bucket create saveattic-media"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.81.0"
  }
}
